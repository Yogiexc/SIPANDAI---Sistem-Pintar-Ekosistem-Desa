generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  COLLECTOR
  ADMIN
}

enum PickupStatus {
  REQUESTED
  SCHEDULED
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum WasteType {
  PLASTIC
  ORGANIC
  PAPER
  METAL
  GLASS
  E_WASTE
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  image         String?
  role          Role      @default(RESIDENT)
  points        Int       @default(0)
  level         String    @default("Beginner") // Beginner, Active, Eco Warrior, Champion
  
  // Relations
  pickups       WastePickup[] @relation("UserPickups")
  assignedTask  WastePickup[] @relation("CollectorPickups")
  products      Product[]
  orders        Order[]
  educationProg UserEducationProgress[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WastePickup {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation("UserPickups", fields: [userId], references: [id])
  
  wasteType       WasteType
  estimatedWeight Float        // in kg
  location        String
  latitude        Float?
  longitude       Float?
  
  status          PickupStatus @default(REQUESTED)
  
  collectorId     String?
  collector       User?        @relation("CollectorPickups", fields: [collectorId], references: [id])
  
  scheduledAt     DateTime?
  completedAt     DateTime?
  
  pointsEarned    Int          @default(0)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  type        String   // "EARNED", "REDEEMED"
  description String
  createdAt   DateTime @default(now())
}

model EducationContent {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  type        String   // "ARTICLE", "VIDEO"
  content     String?  @db.LongText
  videoUrl    String?
  thumbnail   String?
  
  progress    UserEducationProgress[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserEducationProgress {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  educationContentId String
  educationContent  EducationContent @relation(fields: [educationContentId], references: [id])
  completed         Boolean          @default(false)
  completedAt       DateTime?
  
  createdAt         DateTime         @default(now())
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  name        String
  description String   @db.Text
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  
  orders      Order[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  totalAmount Float
  status      String   @default("PENDING") // PENDING, SHIPPED, COMPLETED, CANCELLED
  
  createdAt   DateTime @default(now())
}

model VillageInsight {
  id          String   @id @default(cuid())
  type        String   // "TREND", "ECONOMY", "RECOMMENDATION"
  title       String
  content     String   @db.Text
  generatedAt DateTime @default(now())
}
